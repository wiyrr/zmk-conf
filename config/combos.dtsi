/*                KEY POSITIONS
  ╭─────────────────────╮ ╭─────────────────────╮
  │ LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 │
  │ LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 │
  │ LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 │
  ╰───────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────╯
          ╰─────────────╯ ╰─────────────╯ */

#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

/ {
    combos {
        compatible = "zmk,combos";

        /* Cross-hand combos */
        combo_sys_layer {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LH2 RH2>;
            layers = <DEF>;
            bindings = <&mo SYS>;
        };

        combo_fun_layer {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LH1 RH1>;
            layers = <DEF>;
            bindings = <&mo FUN>;
        };

        combo_capsword {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LH0 RH0>;
            layers = <DEF>;
            bindings = <&caps_word>;
        };

        /* Horizontal combos - left hand */
        combo_del {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LT4 LT3>;
            layers = <DEF>;
            bindings = <&kp DEL>;
        };

        combo_q {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LT3 LT2>;
            layers = <DEF>;
            bindings = <&kp Q>;
        };

        combo_z {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LT2 LT1>;
            layers = <DEF>;
            bindings = <&kp Z>;
        };

        combo_esc {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LM3 LM2>;
            layers = <DEF>;
            bindings = <&kp ESC>;
        };

        combo_lpar {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LM3 LM1>;
            layers = <DEF>;
            bindings = <&kp LPAR>;
        };

        combo_tilde {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LM1 LM0>;
            layers = <DEF>;
            bindings = <&kp TILDE>;
        };

        combo_copy {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LB3 LB2>;
            layers = <DEF>;
            bindings = <&kp LC(INS)>;
        };

        combo_cut {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LB3 LB1>;
            layers = <DEF>;
            bindings = <&kp LC(X)>;
        };

        combo_paste {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LB2 LB1>;
            layers = <DEF>;
            bindings = <&kp LS(INS)>;
        };

        /* Horizontal combos - right hand */
        combo_dollar {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <RT2 RT3>;
            layers = <DEF>;
            bindings = <&kp DOLLAR>;
        };

        combo_bspc {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <RT1 RT2>;
            layers = <DEF>;
            bindings = <&kp BSPC>;
        };

        combo_caret {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <RT0 RT1>;
            layers = <DEF>;
            bindings = <&kp CARET>;
        };

        combo_rpar {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <RM1 RM3>;
            layers = <DEF>;
            bindings = <&kp RPAR>;
        };

        combo_amps {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <RB2 RB3>;
            layers = <DEF>;
            bindings = <&kp AMPS>;
        };


        combo_grave {
            timeout-ms = <COMBO_TERM_FAST>;
            require-prior-idle-ms = <COMBO_IDLE_FAST>;
            key-positions = <LB0 LB1>;
            layers = <DEF>;
            bindings = <&kp GRAVE>;
        };

        /* Vertical combos - left hand */
        combo_lbrc {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <LT2 LM2>;
            layers = <DEF>;
            bindings = <&kp LBRC>;
        };

        combo_lbkt {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <LM2 LB2>;
            layers = <DEF>;
            bindings = <&kp LBKT>;
        };

        combo_excl {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <LT1 LM1>;
            layers = <DEF>;
            bindings = <&kp EXCL>;
        };

        combo_at {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <LM1 LB1>;
            layers = <DEF>;
            bindings = <&kp AT>;
        };

        combo_pipe {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <LT0 LM0>;
            layers = <DEF>;
            bindings = <&kp PIPE>;
        };

        /* Vertical combos - right hand */
        combo_rbrc {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <RT2 RM2>;
            layers = <DEF>;
            bindings = <&kp RBRC>;
        };

        combo_rbkt {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <RM2 RB2>;
            layers = <DEF>;
            bindings = <&kp RBKT>;
        };

        combo_hash {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <RT1 RM1>;
            layers = <DEF>;
            bindings = <&kp HASH>;
        };

        combo_star {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <RM1 RB1>;
            layers = <DEF>;
            bindings = <&kp STAR>;
        };

        combo_prcnt {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <RB1 RB2>;
            layers = <DEF>;
            bindings = <&kp PRCNT>;
        };

        combo_bslh {
            timeout-ms = <COMBO_TERM_SLOW>;
            require-prior-idle-ms = <COMBO_IDLE_SLOW>;
            key-positions = <RT0 RM0>;
            layers = <DEF>;
            bindings = <&kp BSLH>;
        };
    };
};
