/*                KEY POSITIONS

  ╭─────────────────────╮ ╭─────────────────────╮
  │ LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 │
  │ LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 │
  │ LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 │
  ╰───────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────╯
          ╰─────────────╯ ╰─────────────╯ */


#define COMBO_TERM 35
#define COMBO_IDLE 50

#define COMBO_TERM_FAST 18
#define COMBO_IDLE_FAST 150

/ {
    combos {
        compatible = "zmk,combos";
        combo_sys {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LH2 RH2>;
            bindings = <&mo SYS>;
        };
        combo_fun {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LH1 RH1>;
            bindings = <&mo FUN>;
        };
        combo_capsword {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LH0 RH0>;
            bindings = <&caps_word>;
        };
        combo_q {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LT3 LT2>;
            bindings = <&kp Q>;
        };
        combo_z {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LT2 LT1>;
            bindings = <&kp Z>;
        };
        combo_caret {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT1 RT2>;
            bindings = <&kp CARET>;
        };
        combo_star {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT0 RT1>;
            bindings = <&kp STAR>;
        };
        combo_amps {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RB2 RB3>;
            bindings = <&kp AMPS>;
        };
        combo_prcnt {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RB1 RB2>;
            bindings = <&kp PRCNT>;
        };
        combo_grave {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RB0 RB1>;
            bindings = <&kp GRAVE>;
        };
        combo_trigrave {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RB0 RB1>;
            bindings = <&trigrave>;
        };
        combo_tilde {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LB0 LB1>;
            bindings = <&kp TILDE>;
        };
        combo_dollar {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT2 RT3>;
            bindings = <&kp DOLLAR>;
        };
        combo_at {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RB1 RB2>;
            bindings = <&kp AT>;
        };
        combo_hash {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT1 RM1>;
            bindings = <&kp HASH>;
        };
        combo_excl {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LT0 LM0>;
            bindings = <&kp EXCL>;
        };
        combo_lpar {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT3 RM3>;
            bindings = <&kp LPAR>;
        };
        combo_lbrc {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LT2 LM2>;
            bindings = <&kp LBRC>;
        };
        combo_lbkt {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LM2 LB2>;
            bindings = <&kp LBKT>;
        };
        combo_rpar {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT1 RM3>;
            bindings = <&kp RPAR>;
        };
        combo_rbrc {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT2 RM2>;
            bindings = <&kp RBRC>;
        };
        combo_rbkt {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RM2 RB2>;
            bindings = <&kp RBKT>;
        };
        combo_pipe {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LT1 LM1>;
            bindings = <&kp PIPE>;
        };
        combo_bslh {
            timeout-ms = <COMBO_TERM>;
            key-positions = <RT0 RM0>;
            bindings = <&kp BSLH>;
        };
        combo_copy {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LB3 LB2>;
            bindings = <&kp LC(INS)>;
        };
        combo_cut {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LB3 LB1>;
            bindings = <&kp LC(X)>;
        };
        combo_paste {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LB2 LB1>;
            bindings = <&kp LS(INS)>;
        };
        combo_del {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LT4 LT3>;
            bindings = <&kp DEL>;
        };
        combo_selall {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LB2 LB1>;
            bindings = <&kp LC(A)>;
        };
        combo_undo {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LM1 LM0>;
            bindings = <&kp LC(Z)>;
        };
        combo_redo {
            timeout-ms = <COMBO_TERM>;
            key-positions = <LT1 LT0>;
            bindings = <&kp LC(Y)>;
        };
    };
};
